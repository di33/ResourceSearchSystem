# ============================================================
# Server
# ============================================================
DATABASE_URL=postgresql+asyncpg://resource:resource@localhost:5432/resource_upload
MILVUS_HOST=localhost
MILVUS_PORT=19530
DEBUG=true

# #存储桶 API 地址
# KS3_ENDPOINT=http://localhost:9000
# #KS3_ENDPOINT=http://10.11.101.112:9000
# # 预签名 URL，用于预览/下载 URL；不填则使用 KS3_ENDPOINT
# KS3_PUBLIC_ENDPOINT=
# #存储桶名称
# KS3_BUCKET=resources
# #存储桶所在地域
# KS3_REGION=cn-beijing-6
# #地址风格
# KS3_ADDRESSING_STYLE=auto


#存储桶 API 地址
KS3_ENDPOINT=https://cos.ap-guangzhou.myqcloud.com
#公开下载/预览域名
KS3_CDN_ENDPOINT=https://gameai-studio.seasungame.com
#存储桶名称
KS3_BUCKET=game-ai-studio-resource-1252100362
#存储桶所在地域
KS3_REGION=ap-guangzhou
#地址风格
KS3_ADDRESSING_STYLE=virtual


#签名版本
KS3_SIGNATURE_VERSION=s3v4
#预签名 URL 的有效期(秒)
KS3_PRESIGN_EXPIRES=86400

# ============================================================
# Server — Embedding（用于 commit 时自动生成向量 + search 时 query 向量化）
# ============================================================
# provider: ksyun / dashscope / zhipu / mock
SERVER_EMBEDDING_PROVIDER=ksyun
# 模型名称（需为金山云星流平台已开通的 embedding 模型）
SERVER_EMBEDDING_MODEL=qwen3-embedding-8b
# 向量维度
SERVER_EMBEDDING_DIMENSION=4096
# 可选：服务端 embedding 独立 Base URL（默认 https://kspmas.ksyun.com/v1）
SERVER_EMBEDDING_BASE_URL=https://kspmas.ksyun.com/v1
