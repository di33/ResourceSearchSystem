# ============================================================
# ResourceProcessor Tools — LLM（描述生成 + 用途分类，不生成搜索向量）
# ============================================================
# 描述生成 provider: mock / ksyun / dashscope / zhipu / codex
CLIENT_LLM_PROVIDER=ksyun

# --- Ksyun 星流平台（OpenAI 兼容）---
# CLIENT_LLM_PROVIDER=ksyun 时，API Key 放在 Client/.env.local
# 可选：LLM 独立 Base URL（默认 https://kspmas.ksyun.com/v1）
CLIENT_LLM_BASE_URL=https://kspmas.ksyun.com/v1
# 需替换为星流平台可用模型，例如 glm-4.7 / kimi-k2-0905-preview
#KSPMAS_LLM_MODEL=qwen3-vl-235b-a22b-instruct
KSPMAS_LLM_MODEL=mimo-v2.5
KSPMAS_LLM_TIMEOUT=180
AUDIO_LLM_MODEL=mimo-v2.5
# 结构化输出：json_schema / json_object / none。若星流模型不支持 json_schema，可临时改为 json_object 或 none
KSPMAS_RESPONSE_FORMAT=json_schema
KSPMAS_TEMPERATURE=0
# 音频请求体保护：超过阈值的音频会优先截取并压缩；压缩失败则仅使用标题/路径/元数据
KSPMAS_MAX_AUDIO_INPUT_BYTES=4194304
KSPMAS_AUDIO_SAMPLE_SECONDS=30
KSPMAS_AUDIO_SAMPLE_BITRATE=48k

# --- Pack 描述聚合 Embedding（仅用于包描述子资源聚类，不写入搜索库）---
# API Key 放在 Client/.env.local：KSPMAS_API_KEY / DASHSCOPE_API_KEY / ZHIPUAI_API_KEY
RESOURCE_EMBEDDING_PROVIDER=ksyun
RESOURCE_EMBEDDING_BASE_URL=https://kspmas.ksyun.com/v1
RESOURCE_EMBEDDING_MODEL=qwen3-embedding-8b
RESOURCE_EMBEDDING_DIMENSION=4096
RESOURCE_EMBEDDING_BATCH_SIZE=64
RESOURCE_EMBEDDING_TIMEOUT=60
PACK_DESCRIPTION_SIMILARITY_THRESHOLD=0.92
PACK_DESCRIPTION_MAX_CHILD_EXAMPLES=30
PACK_DESCRIPTION_MIN_CLUSTERS_PER_TYPE=2
PACK_DESCRIPTION_CLUSTER_EXTRA_SAMPLES=2
PACK_DESCRIPTION_TITLE_EXAMPLES=6
PACK_DESCRIPTION_MAX_EMBEDDING_ITEMS=5000
PACK_DESCRIPTION_REQUIRE_ALL_CHILD_DESCRIPTIONS=true
PACK_DESCRIPTION_MIN_CHILD_DESCRIPTIONS=1
PACK_DESCRIPTION_PROMPT_VERSION=pack_child_embedding_summary_v1

# --- DashScope (阿里云百炼) ---
# CLIENT_LLM_PROVIDER=dashscope 时，API Key 放在 Client/.env.local
DASHSCOPE_LLM_MODEL=qwen-vl-max

# --- ZhipuAI (智谱) ---
# CLIENT_LLM_PROVIDER=zhipu 时，API Key 放在 Client/.env.local
ZHIPUAI_LLM_MODEL=glm-5.1

# --- 预览与媒体工具（按部署环境配置，可留空走自动发现）---
BLENDER_EXE=
TMXRASTERIZER=
RESVG_JS_MODULE=
FFMPEG_BINARY=

# ============================================================
# LLM 提示词配置
# ============================================================
LLM_DESCRIPTION_PROMPT=你是游戏资源检索场景下的中文描述生成助手。你的任务是根据输入载体（如预览图、音频）和结构化元数据，为每个资源生成适合检索与人工检查的描述内容。\n1. main_content：40-90字，优先说明资源类型、核心内容、风格特征、适用场景，语言自然、准确、可检索。\n2. detail_content：40-120字，补充格式、构成、数量、视角、用途、兼容场景、授权或限制中的可确定信息；写成自然中文短句。\n3. 如果某些信息不确定，就只写能从输入载体和元数据确认的内容；不要编造，不要照抄原始 description 整句。\n4. detail_content 不能留空；若可确认信息较少，就概括补充“适合用于……”或“可作为……素材”等稳妥描述。\n5. 若资源是 pack、tileset、animation_sequence、font_file、audio_file 等非单图资源，应优先结合 metadata 理解整体用途，而不是只盯某一张预览图。\n6. 请直接描述这个资源本身，不要描述任务说明或上下文文本。
LLM_PACK_DESCRIPTION_PROMPT=你是游戏素材包描述生成助手。输入会按 resource_type 分段，并给出每类内部经过 embedding 聚类后的代表语义组；每组包含覆盖数量、标题示例、中心样本和差异样本。请总结整个资源包，而不是逐条罗列或简单相加。\n1. main_content：50-100字，概括资源包整体主题、核心内容、主要风格、适用游戏类型或场景。\n2. detail_content：80-180字，说明包内资源覆盖范围、各资源类型的作用、重复/变体关系、主要子类型、可组合用途和显著差异；可以引用代表组的覆盖数量，但不要列清单。\n3. 优先提炼高频特征和共同用途，再补充少量有区分度的内容；避免把同类图标、帧、音效或部件重复写很多遍。\n4. 只使用输入中能确认的信息，不要编造具体授权、文件数量之外的内容，不要照抄每条子资源描述。\n5. 输出仍必须遵循 JSON 格式要求，detail_content 不能留空。
LLM_TYPE_PROMPT=根据资源导入游戏后的空间使用形态与直接用途完成用途分类。分类只表达直接用途，不表达对象主题、风格、颜色、材质、时代、具体名称、文件格式或制作工具。必须从可用分类规则中选择最合适的 space、category 和 subcategories；如果证据不足，space 可选“不确定”，但 category 仍应尽量根据用途规则选择。
