# ============================================================
# Resource processing server - same-host Docker deployment
# ============================================================
# SearchServer and preview_renderer run as separate Compose projects on the
# same host, so containers reach their published host ports through this name.
RP_SEARCH_SERVER_URL=http://host.docker.internal:8000
RP_PREVIEW_RENDERER_URL=http://host.docker.internal:8200

# Server-side description generation. Provider credentials stay in .env.local.
RP_LLM_PROVIDER=ksyun
RP_LLM_MODEL=mimo-v2.5

# Keep the databases and service ports host-local unless remote access is
# explicitly required.
RP_BIND_HOST=0.0.0.0
RP_PORT=9000
RP_POSTGRES_BIND_HOST=127.0.0.1
RP_POSTGRES_PORT=5433

# Bound processing throughput so large imports do not overwhelm SearchServer.
RP_JOB_WORKER_CONCURRENCY=4
RP_DATABASE_POOL_MIN_SIZE=2
RP_DATABASE_POOL_MAX_SIZE=12
