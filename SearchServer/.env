# ============================================================
# Server
# ============================================================
DATABASE_URL=postgresql+asyncpg://resource:resource@localhost:5432/resource_upload
MILVUS_HOST=localhost
MILVUS_PORT=19530
DEBUG=true

# 对象存储 bucket / endpoint / region / CDN / 鉴权模式统一配置在
# ../Tools/storage_profiles.jsonc；这里只保留 SearchServer 自身配置。

# ============================================================
# Server — Embedding（用于 commit 时自动生成向量 + search 时 query 向量化）
# ============================================================
# provider: ksyun / dashscope / zhipu / mock
SERVER_EMBEDDING_PROVIDER=ksyun
# 模型名称（需为金山云星流平台已开通的 embedding 模型）
SERVER_EMBEDDING_MODEL=qwen3-embedding-8b
# 向量维度
SERVER_EMBEDDING_DIMENSION=4096
# 可选：服务端 embedding 独立 Base URL（默认 https://kspmas.ksyun.com/v1）
SERVER_EMBEDDING_BASE_URL=https://kspmas.ksyun.com/v1
